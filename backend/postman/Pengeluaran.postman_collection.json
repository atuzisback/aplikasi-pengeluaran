{
  "info": {
    "name": "API Pengeluaran",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Daftar pengeluaran (layar 01/13/14)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pengeluaran",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pengeluaran"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Berupa array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Daftar kategori (layar 03)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/kategori",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "kategori"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Tambah - valid (layar 04-06 -> 07)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pengeluaran",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pengeluaran"
          ]
        },
        "description": "Menyimpan id ke variabel {{id}} untuk request berikutnya.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"Makan malam\",\n  \"nominal\": 30000,\n  \"kategori_id\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const d = pm.response.json();",
              "pm.collectionVariables.set('id', d.id);",
              "pm.test('Tanggal diisi server', () => pm.expect(d.tanggal).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Tambah - form error (layar 05)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pengeluaran",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pengeluaran"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"\",\n  \"nominal\": -5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Ada pesan error', () => pm.expect(pm.response.json().errors).to.have.property('judul'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Detail (layar 08)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pengeluaran/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pengeluaran",
            "{{id}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Ubah (layar 09 -> 10)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pengeluaran/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pengeluaran",
            "{{id}}"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"Makan malam (ubah)\",\n  \"nominal\": 35000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Nominal berubah', () => pm.expect(pm.response.json().nominal).to.eql(35000));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Hapus (layar 11 -> 12)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pengeluaran/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pengeluaran",
            "{{id}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Detail data tidak ada (layar 15)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pengeluaran/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pengeluaran",
            "{{id}}"
          ]
        },
        "description": "Dijalankan setelah Hapus, sehingga data sudah tidak ada."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "id",
      "value": "1"
    }
  ]
